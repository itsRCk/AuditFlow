{
  "name": "auditflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "format": "prettier --write src scripts/dev.mjs vite.config.ts index.html README.md package.json tsconfig.json",
    "format:check": "prettier --check src scripts/dev.mjs vite.config.ts index.html README.md package.json tsconfig.json",
    "start": ".venv/bin/python -m uvicorn server.main:app --host 0.0.0.0 --port 3000",
    "test": ".venv/bin/python -m unittest discover -s tests -v",
    "evaluate": ".venv/bin/python -m server.evaluate",
    "test:e2e": ".venv/bin/python -m scripts.browser_smoke"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
