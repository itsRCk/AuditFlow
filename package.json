{
  "name": "auditflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "build:vercel": "node scripts/check-deploy-env.mjs && npm run build",
    "format": "prettier --write src api scripts/*.mjs public/assets/theme.js components.json vite.config.ts index.html README.md package.json tsconfig.json vercel.json compose.yaml",
    "format:check": "prettier --check src api scripts/*.mjs public/assets/theme.js components.json vite.config.ts index.html README.md package.json tsconfig.json vercel.json compose.yaml",
    "start": ".venv/bin/python -m uvicorn server.main:app --host 0.0.0.0 --port 3000",
    "test": ".venv/bin/python -m unittest discover -s tests -v",
    "evaluate": ".venv/bin/python -m server.evaluate",
    "test:e2e": ".venv/bin/python -m scripts.browser_smoke"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@vercel/blob": "2.8.1",
    "@vercel/queue": "0.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/node": "21.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
