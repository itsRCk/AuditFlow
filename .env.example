# Defaults run entirely locally. Use secure process/environment settings for keys.
AUDITFLOW_SEED_DEMO=true
AUDITFLOW_AI_ENABLED=false
# AUDITFLOW_DATA_DIR=/absolute/path/to/persistent/storage

# Optional Gemini multimodal extraction. Enabling it sends uploaded page images
# to generativelanguage.googleapis.com. Never commit or share an API key.
# AUDITFLOW_AI_KEY=
# AUDITFLOW_AI_MODEL=gemini-2.5-flash
# Use current provider rates to measure cost; absent rates yield "Unknown".
# AUDITFLOW_AI_INPUT_USD_PER_MILLION=
# AUDITFLOW_AI_OUTPUT_USD_PER_MILLION=
